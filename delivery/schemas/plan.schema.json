{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "affectedAreas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "validationCommands": { "type": "array", "items": { "type": "string" } },
    "parallelismRationale": { "type": "string" },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,63}$" },
          "title": { "type": "string" },
          "kind": { "type": "string", "enum": ["implementation", "test", "documentation", "integration", "repair"] },
          "role": { "type": "string", "enum": ["implementer", "test_engineer", "docs", "integrator", "debugger"] },
          "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "criterionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" } },
          "required": { "type": "boolean" },
          "instructions": { "type": "array", "items": { "type": "string" } },
          "localValidationCommands": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "title", "kind", "role", "scope", "dependsOn", "criterionIds", "required", "instructions", "localValidationCommands"],
        "additionalProperties": false
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["summary", "acceptanceCriteria", "nonGoals", "affectedAreas", "validationCommands", "parallelismRationale", "workstreams", "risks", "assumptions"],
  "additionalProperties": false
}

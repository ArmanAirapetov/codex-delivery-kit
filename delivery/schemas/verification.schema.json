{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": { "type": "string", "enum": ["passed", "failed", "inconclusive"] },
    "summary": { "type": "string" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["proven", "failed", "unknown"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } },
          "commands": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "status", "evidence", "paths", "commands"],
        "additionalProperties": false
      }
    },
    "failedCommands": { "type": "array", "items": { "type": "string" } },
    "residualRisks": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["verdict", "summary", "criteria", "failedCommands", "residualRisks"],
  "additionalProperties": false
}
